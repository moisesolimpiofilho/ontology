# Copie para .env e ajuste. Sem .env, o docker-compose usa os padrões de desenvolvimento.
NEO4J_PASSWORD=senha_forte_neo4j
POSTGRES_PASSWORD=senha_forte_postgres
MONGO_PASSWORD=senha_forte_mongo
FLASK_DEBUG=1
MAX_UPLOAD_MB=10

# Sessões de login (troque fora do ambiente local)
SECRET_KEY=dev-secret-key-mude-em-producao

# Senha das contas de demonstração criadas no primeiro boot:
#   engenheiro (Engenheiro de Conhecimento), especialista (Especialista de Domínio),
#   stakeholder (Stakeholder). Só vale se o banco ainda não tiver usuários.
SEED_PASSWORD=ontocube123

# Agente LLM (Claude). Deixe vazio para desativar o agente.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high

# Tempo máximo (s) do raciocinador HermiT por verificação
REASONER_TIMEOUT=120
